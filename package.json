  "engines": {
    "node": ">=24.22.1",
    "npm": ">=11.18.0"
  },
  "volta": {
    "node": "24.22.1"
  },
  "devDependencies": {
    "@wordpress/env": "^12.0.0",
    "npm-run-all": "^4.1.5"
  },
  "scripts": {
    "wp-env": "wp-env",
    "start": "wp-env start",
    "stop": "wp-env stop",
    "cli": "wp-env run cli",
    "wp": "wp-env run cli wp",
    "pretest": "wp-env start && wp-env run cli composer install --no-interaction --working-dir=/var/www/html/wp-content/plugins/wp-helper",
    "test:lint:php": "wp-env run cli composer --working-dir=/var/www/html/wp-content/plugins/wp-helper run-script lint",
    "test:lint": "run-s test:lint:*",
    "test:unit:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/wp-helper vendor/bin/phpunit -c .phpunit.xml.dist --verbose",
    "test:unit": "run-s test:unit:*",
    "test": "run-s test:*"
  }
}
